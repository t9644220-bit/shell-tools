## 初始化安装包名称（依赖 PKG_ARCH 与各组件版本号）
init_package_names () {
  CONTAINERD_PACKAGE_NAME="containerd-${CONTAINERD_VERSION}-linux-${PKG_ARCH}.tar.gz"
  RUNC_PACKAGE_NAME="runc-v${RUNC_VERSION}.${PKG_ARCH}"
  CNI_PLUGINS_PACKAGE_NAME="cni-plugins-linux-${PKG_ARCH}-v${CNI_PLUGINS_VERSION}.tgz"
  CRICTL_PACKAGE_NAME="crictl-v${CRICTL_VERSION}-linux-${PKG_ARCH}.tar.gz"
  KUBE_PACKAGE_SUFFIX="v${K8S_VERSION}-linux-${PKG_ARCH}"
  IMAGES_PACKAGE_NAME="k8s-images-v${K8S_VERSION}-${NETWORK_PLUGIN}-linux-${PKG_ARCH}.tar"

  case "${NETWORK_PLUGIN}" in
    flannel)
      NETWORK_MANIFEST_NAME="kube-flannel-v${FLANNEL_VERSION}.yml"
      NETWORK_MANIFEST_URL="${FLANNEL_MANIFEST_URL}/v${FLANNEL_VERSION}/kube-flannel.yml"
      ;;
    calico)
      NETWORK_MANIFEST_NAME="calico-v${CALICO_VERSION}.yaml"
      NETWORK_MANIFEST_URL="${CALICO_MANIFEST_URL}/v${CALICO_VERSION}/manifests/calico.yaml"
      ;;
    *)
      NETWORK_MANIFEST_NAME=""
      NETWORK_MANIFEST_URL=""
      ;;
  esac
}

## 校验安装包（存在同名 .sha256 文件时校验，否则跳过）
verify_package () {
  local file="$1"

  [[ -f "${file}.sha256" ]] || return 0
  (cd "$(dirname "${file}")" && sha256sum -c --status "$(basename "${file}").sha256")
}

## 下载文件（可选校验 sha256，并在目标文件旁生成 .sha256 供离线安装校验）
download_file () {
  local url="$1"
  local dest="$2"
  local sha_url="${3:-}"
  local name content expected actual

  if [[ -s "${dest}" ]]; then
    if verify_package "${dest}"; then
      log_info "安装包已存在，跳过下载： ${dest}"
      return 0
    fi
    log_warning "安装包校验失败，重新下载： ${dest}"
    rm -f "${dest}" "${dest}.sha256"
  fi

  log_info "开始下载： ${url}"
  if ! curl -fL --retry 3 --connect-timeout 10 -o "${dest}.part" "${url}"; then
    rm -f "${dest}.part"
    log_error "下载失败： ${url}"
  fi

  if [[ -n "${sha_url}" ]]; then
    name="$(basename "${url}")"
    content="$(curl -fsSL --retry 3 --connect-timeout 10 "${sha_url}")" || log_error "获取校验和失败： ${sha_url}"
    # 校验和文件有两种格式：「哈希  文件名」（可能多行）或仅有哈希
    expected="$(awk -v n="${name}" '{f = $NF; sub(/^\*/, "", f)} f == n && $1 ~ /^[0-9a-f]{64}$/ {print $1; exit}' <<<"${content}")"
    if [[ -z "${expected}" ]]; then
      expected="$(awk 'match($0, /^[0-9a-f]{64}/) {print substr($0, 1, 64); exit}' <<<"${content}")"
    fi
    if [[ -z "${expected}" ]]; then
      rm -f "${dest}.part"
      log_error "无法解析校验和： ${sha_url}"
    fi
    actual="$(sha256sum "${dest}.part" | awk '{print $1}')"
    if [[ "${expected}" != "${actual}" ]]; then
      rm -f "${dest}.part"
      log_error "校验和不匹配： ${url}（期望 ${expected}，实际 ${actual}）"
    fi
    echo "${expected}  $(basename "${dest}")" > "${dest}.sha256"
    log_info "校验通过： $(basename "${dest}")"
  fi

  mv -f "${dest}.part" "${dest}"
}

## 下载全部安装包
download_packages () {
  log_info '------------------------------ 开始下载安装包... ------------------------------'

  local url

  mkdir -pv "${PACKAGE_DIR}"

  url="${CONTAINERD_PACKAGE_URL}/v${CONTAINERD_VERSION}/containerd-${CONTAINERD_VERSION}-linux-${PKG_ARCH}.tar.gz"
  download_file "${url}" "${PACKAGE_DIR}/${CONTAINERD_PACKAGE_NAME}" "${url}.sha256sum"

  url="${RUNC_PACKAGE_URL}/v${RUNC_VERSION}/runc.${PKG_ARCH}"
  download_file "${url}" "${PACKAGE_DIR}/${RUNC_PACKAGE_NAME}" "${RUNC_PACKAGE_URL}/v${RUNC_VERSION}/runc.sha256sum"

  url="${CNI_PLUGINS_PACKAGE_URL}/v${CNI_PLUGINS_VERSION}/cni-plugins-linux-${PKG_ARCH}-v${CNI_PLUGINS_VERSION}.tgz"
  download_file "${url}" "${PACKAGE_DIR}/${CNI_PLUGINS_PACKAGE_NAME}" "${url}.sha256"

  url="${CRICTL_PACKAGE_URL}/v${CRICTL_VERSION}/crictl-v${CRICTL_VERSION}-linux-${PKG_ARCH}.tar.gz"
  download_file "${url}" "${PACKAGE_DIR}/${CRICTL_PACKAGE_NAME}" "${url}.sha256"

  download_kube_packages

  if [[ -n "${NETWORK_MANIFEST_URL}" ]]; then
    download_file "${NETWORK_MANIFEST_URL}" "${PACKAGE_DIR}/${NETWORK_MANIFEST_NAME}"
  fi

  log_info '------------------------------ 安装包下载完成! ------------------------------'
}

## 下载 Kubernetes 组件（kubeadm、kubelet、kubectl）
download_kube_packages () {
  local bin url

  mkdir -p "${PACKAGE_DIR}"
  for bin in kubeadm kubelet kubectl; do
    url="${K8S_PACKAGE_URL}/v${K8S_VERSION}/bin/linux/${PKG_ARCH}/${bin}"
    download_file "${url}" "${PACKAGE_DIR}/${bin}-${KUBE_PACKAGE_SUFFIX}" "${url}.sha256"
  done
}

## 准备安装包（在线安装时下载，离线安装时已在 check_file 中校验）
prepare_packages () {
  if [[ "${NEED_OFFLINE_INSTALL}" == false ]]; then
    download_packages
  fi
}


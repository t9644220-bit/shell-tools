#!/bin/bash
set -euo pipefail

# Kubernetes 工具

# 参数配置
## 版本号
VERSION=1.0.0
## 当前的日期时间
DATETIME="$(date '+%Y%m%d_%H%M%S')"
## 工具所在目录（模板文件、默认安装包目录均相对于此目录，与执行时所在目录无关）
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
## 服务器 CPU 架构（运行时自动探测，见 check_cpu_arch）
CPU_ARCH=""
## 本机架构（amd64 / arm64，由 CPU_ARCH 换算）
HOST_ARCH=""
## 安装包架构（默认与本机一致；download / save-images 可通过 -b 指定其他架构）
PKG_ARCH=""
## 用户指定的安装包架构（-b）
TARGET_ARCH=""
## 系统配置文件目录
SYSTEMD_DIR=/usr/lib/systemd/system
## Kubernetes 安装目录（程序位于 bin/，配置位于 conf/，更新备份位于 backup/）
K8S_INSTALL_DIR=/opt/kubernetes
## Kubernetes 数据目录（containerd 数据位于 containerd/，etcd 数据位于 etcd/）
K8S_DATA_DIR=/opt/kubernetes/data
## 安装包目录（在线安装时下载到此目录，离线安装时从此目录读取）
PACKAGE_DIR="${SCRIPT_DIR}/packages"
## 是否离线安装（默认在线安装，通过 -o 切换为离线安装）
NEED_OFFLINE_INSTALL=false

## Kubernetes 版本号（kubeadm、kubelet、kubectl）
K8S_VERSION=1.37.1
## Kubernetes 安装包下载地址
K8S_PACKAGE_URL=https://dl.k8s.io/release
## containerd 版本号
CONTAINERD_VERSION=2.4.2
## containerd 安装包下载地址
CONTAINERD_PACKAGE_URL=https://github.com/containerd/containerd/releases/download
## runc 版本号
RUNC_VERSION=1.5.2
## runc 安装包下载地址
RUNC_PACKAGE_URL=https://github.com/opencontainers/runc/releases/download
## CNI 插件版本号
CNI_PLUGINS_VERSION=1.9.1
## CNI 插件安装包下载地址
CNI_PLUGINS_PACKAGE_URL=https://github.com/containernetworking/plugins/releases/download
## CNI 插件安装目录（kubelet / containerd / 网络插件约定的标准路径，不建议修改）
CNI_BIN_DIR=/opt/cni/bin
## crictl 版本号
CRICTL_VERSION=1.37.0
## crictl 安装包下载地址
CRICTL_PACKAGE_URL=https://github.com/kubernetes-sigs/cri-tools/releases/download

## 网络插件（flannel、calico、none）
NETWORK_PLUGIN=flannel
## Flannel 版本号
FLANNEL_VERSION=0.28.10
## Flannel 清单下载地址
FLANNEL_MANIFEST_URL=https://github.com/flannel-io/flannel/releases/download
## Calico 版本号
CALICO_VERSION=3.33.0
## Calico 清单下载地址
CALICO_MANIFEST_URL=https://raw.githubusercontent.com/projectcalico/calico

## 节点角色（master：初始化集群；worker：作为工作节点加入集群；control-plane：作为控制平面节点加入集群）
NODE_ROLE=master
## 是否在安装组件后初始化 / 加入集群（-a 时为 false，仅安装组件）
NEED_SETUP_CLUSTER=true
## 本机通信地址（advertise address，留空则自动探测）
ADVERTISE_ADDRESS=""
## 控制平面统一入口（高可用时填写负载均衡地址，如 192.168.1.100:6443）
CONTROL_PLANE_ENDPOINT=""
## 要加入的集群 API Server 地址（worker / control-plane 使用，如 192.168.1.10:6443）
API_SERVER_ADDRESS=""
## 加入集群使用的 Token
JOIN_TOKEN=""
## 加入集群使用的 CA 证书哈希（sha256:xxx）
JOIN_CA_CERT_HASH=""
## 加入控制平面使用的证书密钥（certificate key）
JOIN_CERTIFICATE_KEY=""
## Pod 网段
POD_CIDR=10.244.0.0/16
## Service 网段
SERVICE_CIDR=10.96.0.0/12
## kube-proxy 模式（iptables、ipvs、nftables）
KUBE_PROXY_MODE=iptables
## 镜像仓库（Kubernetes 组件镜像，国内可使用 registry.aliyuncs.com/google_containers）
IMAGE_REPOSITORY=registry.k8s.io
## 镜像加速（格式：仓库=加速地址，多个以逗号分隔，如 docker.io=https://docker.1ms.run,ghcr.io=https://ghcr.nju.edu.cn）
REGISTRY_MIRRORS=""
## 是否允许在控制平面节点调度 Pod（单节点集群时使用）
NEED_UNTAINT_MASTER=false
## 是否关闭 swap
NEED_DISABLE_SWAP=true
## 忽略的 kubeadm 预检错误（如 NumCPU,Mem，多个以逗号分隔，留空则不忽略）
KUBEADM_IGNORE_PREFLIGHT_ERRORS=""
## 是否跳过所有交互确认（-y）
ASSUME_YES=false

## 容器运行时 Socket
CRI_SOCKET=unix:///run/containerd/containerd.sock
## 集群管理员 kubeconfig
KUBE_ADMIN_CONF=/etc/kubernetes/admin.conf
## 本工具写入系统配置文件的标识
TOOL_MARK=kubernetes-tools

# 日志颜色
## 普通颜色
readonly COLOR_RESET='\033[0m'
readonly COLOR_RED='\033[0;31m'
readonly COLOR_GREEN='\033[0;32m'
readonly COLOR_YELLOW='\033[0;33m'
readonly COLOR_BLUE='\033[0;34m'
readonly COLOR_CYAN='\033[0;36m'

## 加粗颜色
readonly COLOR_BOLD_RED='\033[1;31m'
readonly COLOR_BOLD_GREEN='\033[1;32m'
readonly COLOR_BOLD_YELLOW='\033[1;33m'
readonly COLOR_BOLD_BLUE='\033[1;34m'
readonly COLOR_BOLD_CYAN='\033[1;36m'

# 相关方法
## 调试
log_debug () {
  echo -e "${COLOR_BOLD_CYAN}[DEBUG]${COLOR_RESET} [$(date '+%Y-%m-%d %H:%M:%S')] ${COLOR_CYAN}$* ${COLOR_RESET}"
}

## 信息
log_info () {
  echo -e "${COLOR_BOLD_BLUE}[INFO]${COLOR_RESET} [$(date '+%Y-%m-%d %H:%M:%S')] ${COLOR_BLUE}$* ${COLOR_RESET}"
}

## 警告
log_warning () {
  echo -e "${COLOR_BOLD_YELLOW}[WARN]${COLOR_RESET} [$(date '+%Y-%m-%d %H:%M:%S')] ${COLOR_YELLOW}$* ${COLOR_RESET}" >&2
}

## 错误
log_error () {
  echo -e "${COLOR_BOLD_RED}[ERROR] ${COLOR_RESET}[$(date '+%Y-%m-%d %H:%M:%S')] ${COLOR_RED}$* ${COLOR_RESET}" >&2
  exit 1
}

## 成功
log_success () {
  echo -e "${COLOR_BOLD_GREEN}[INFO]${COLOR_RESET} [$(date '+%Y-%m-%d %H:%M:%S')] ${COLOR_GREEN}$* ${COLOR_RESET}"
}

## 备份文件或目录
backup_file () {
  local src="$1"
  local backup
  backup="${src}.bak.$(date '+%Y%m%d_%H%M%S')"

  # 时间戳到秒，若 1 秒内连续调用则追加进程号避免覆盖
  if [[ -e "$backup" ]]; then
    backup="${backup}.$$"
  fi

  if [[ -e "$src" ]]; then
    cp -rpf "$src" "$backup" || log_warning "备份 $src 失败"
    log_info "已备份: $src -> $backup"
  fi
}

## 循环提示
confirm_action () {
  local prompt="$1"
  local response

  if [[ "${ASSUME_YES}" == true ]]; then
    log_info "${prompt}： 已通过 -y 自动确认"
    return 0
  fi

  while true; do
    if ! read -rp "${prompt} (y/n): " response; then
      log_error '无法读取输入，非交互环境请使用 -y 跳过确认！'
    fi
    case "${response,,}" in  # 转小写
      y|yes) return 0 ;;
      n|no) return 1 ;;
      *) log_warning "请输入 y 或 n" ;;
    esac
  done
}

## 卸载指定目录下的所有挂载点（由深到浅）
umount_under () {
  local dir="$1"
  local mnt

  [[ -d "${dir}" ]] || return 0

  awk -v d="${dir}" '$2 == d || index($2, d "/") == 1 {print $2}' /proc/mounts | sort -r | while read -r mnt; do
    umount "${mnt}" 2>/dev/null || umount -l "${mnt}" 2>/dev/null || log_warning "卸载挂载点失败： ${mnt}"
  done
}

## 去除路径末尾的 /（保留根目录 /）
strip_slash () {
  local path="$1"
  while [[ "${path}" == */ && "${path}" != / ]]; do
    path="${path%/}"
  done
  echo "${path}"
}

## 比较版本号：$1 < $2 时返回 0
version_lt () {
  [[ "$1" != "$2" && "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" == "$1" ]]
}

## 检查 root 权限
check_root () {
  if [[ "${EUID}" -ne 0 ]]; then
    log_error "必须以 root 用户运行，请切换用户！"
  fi
}

## 检查 systemd
check_systemd () {
  if [[ ! -d /run/systemd/system ]]; then
    log_error "未检测到 systemd，kubernetes-tools 仅支持使用 systemd 的 Linux 发行版！"
  fi
}

## 架构名称换算（x86_64 / amd64 -> amd64，aarch64 / arm64 -> arm64）
normalize_arch () {
  case "$1" in
    x86_64|amd64) echo amd64 ;;
    aarch64|arm64) echo arm64 ;;
    *) echo "" ;;
  esac
}

## 检查 CPU 架构
check_cpu_arch () {
  CPU_ARCH="$(uname -m)"
  HOST_ARCH="$(normalize_arch "${CPU_ARCH}")"
  if [[ -z "${HOST_ARCH}" ]]; then
    log_error "不支持的 CPU 架构： ${CPU_ARCH}（仅支持 x86_64、aarch64）！"
  fi
  log_info "检测到 CPU 架构： ${CPU_ARCH}"
  PKG_ARCH="${HOST_ARCH}"
}

## 确定安装包架构（仅 download / save-images 允许与本机不同）
resolve_package_arch () {
  check_cpu_arch
  if [[ -n "${TARGET_ARCH}" ]]; then
    PKG_ARCH="$(normalize_arch "${TARGET_ARCH}")"
    if [[ -z "${PKG_ARCH}" ]]; then
      log_error "不支持的目标架构： ${TARGET_ARCH}（仅支持 amd64 / x86_64、arm64 / aarch64）！"
    fi
  fi
  log_info "安装包架构： ${PKG_ARCH}"
}

## 检查发行版（在子 shell 中读取 /etc/os-release，避免其 VERSION 等变量覆盖本脚本变量）
check_os_release () {
  if [[ ! -f /etc/os-release ]]; then
    log_error "无法检测操作系统！"
  fi

  log_info "发行版ID： $(. /etc/os-release && echo "${ID:-unknown}")"
  log_info "发行版名称： $(. /etc/os-release && echo "${NAME:-unknown}")"
  log_info "发行版版本号： $(. /etc/os-release && echo "${VERSION_ID:-unknown}")"
}

## 探测包管理器（用于给出依赖安装提示）
detect_package_manager () {
  local pm
  for pm in dnf yum zypper apt-get; do
    if command -v "${pm}" >/dev/null 2>&1; then
      echo "${pm}"
      return 0
    fi
  done
  echo ""
}

## 命令对应的软件包名称
command_package_name () {
  local cmd="$1"
  local pm="$2"
  case "${cmd}" in
    conntrack)
      [[ "${pm}" == apt-get ]] && echo conntrack || echo conntrack-tools
      ;;
    ip)
      [[ "${pm}" == dnf || "${pm}" == yum ]] && echo iproute || echo iproute2
      ;;
    mount|nsenter)
      echo util-linux
      ;;
    modprobe)
      echo kmod
      ;;
    *)
      echo "${cmd}"
      ;;
  esac
}

## 检查依赖命令
check_command () {
  local required=(tar iptables conntrack socat ip mount nsenter modprobe sysctl sha256sum)
  local missing=()
  local packages=()
  local cmd pm pkg

  if [[ "${NEED_OFFLINE_INSTALL}" == false ]]; then
    required+=(curl)
  fi

  for cmd in "${required[@]}"; do
    if ! command -v "${cmd}" >/dev/null 2>&1; then
      missing+=("${cmd}")
    fi
  done

  if [[ "${KUBE_PROXY_MODE}" == ipvs ]]; then
    for cmd in ipset ipvsadm; do
      if ! command -v "${cmd}" >/dev/null 2>&1; then
        log_warning "kube-proxy 使用 ipvs 模式时建议安装 ${cmd}"
      fi
    done
  fi

  if [[ ${#missing[@]} -gt 0 ]]; then
    pm="$(detect_package_manager)"
    for cmd in "${missing[@]}"; do
      pkg="$(command_package_name "${cmd}" "${pm}")"
      [[ " ${packages[*]-} " == *" ${pkg} "* ]] || packages+=("${pkg}")
    done
    if [[ -n "${pm}" ]]; then
      log_error "缺少依赖命令： ${missing[*]}，请先执行【 ${pm} install -y ${packages[*]} 】安装！"
    fi
    log_error "缺少依赖命令： ${missing[*]}，请先通过包管理器安装（软件包： ${packages[*]}）！"
  fi
}

## 检查文件
check_file () {
  local file
  local templates=(containerd.service kubelet.service 10-kubeadm.conf kubeadm-config.yaml)

  # 检查安装必须的模板文件
  for file in "${templates[@]}"; do
    if [[ ! -e "${SCRIPT_DIR}/${file}" ]]; then
      log_error "未在本脚本的同级目录找到【 ${file} 】文件！"
    fi
  done

  # 离线安装时，检查安装包是否齐全
  if [[ "${NEED_OFFLINE_INSTALL}" == true ]]; then
    for file in "${CONTAINERD_PACKAGE_NAME}" "${RUNC_PACKAGE_NAME}" "${CNI_PLUGINS_PACKAGE_NAME}" "${CRICTL_PACKAGE_NAME}" \
                "kubeadm-${KUBE_PACKAGE_SUFFIX}" "kubelet-${KUBE_PACKAGE_SUFFIX}" "kubectl-${KUBE_PACKAGE_SUFFIX}"; do
      check_package "${file}"
    done
  fi
}

## 检查单个离线安装包（存在且校验和正确）
check_package () {
  local file="$1"

  if [[ ! -s "${PACKAGE_DIR}/${file}" ]]; then
    log_error "未在安装包目录【 ${PACKAGE_DIR} 】找到【 ${file} 】，请先在联网机器上执行【 kubernetes-tools download 】！"
  fi
  if ! verify_package "${PACKAGE_DIR}/${file}"; then
    log_error "安装包【 ${file} 】校验和不匹配，文件可能已损坏，请重新下载！"
  fi
}

## 检查 URL 是否可达（通用，仅请求 1 个字节）
check_url_reachable () {
  local url="$1"
  local label="$2"
  local timeout="${3:-10}"
  local http_code

  # 允许 curl 失败，自己根据返回码判断
  http_code=$(curl -sSL -r 0-0 -o /dev/null -w "%{http_code}" --connect-timeout "${timeout}" --max-time $((timeout * 3)) "${url}" || echo "000")
  log_debug "${url} -> ${http_code}"

  case "${http_code}" in
    2??|3??)
      return 0
      ;;
    000)
      log_error "无法获取 ${label}： 网络不可达（连接失败）！"
      ;;
    4??)
      log_error "无法获取 ${label}： 客户端错误（${http_code}），请检查版本号是否正确！"
      ;;
    5??)
      log_error "无法获取 ${label}： 服务器错误（${http_code}）！"
      ;;
    *)
      log_error "无法获取 ${label}： 未知响应码（${http_code}）！"
      ;;
  esac
}

## 检查网络
check_net () {
  # 在线安装时，检查是否能正常获取安装包（仅检查校验和文件，体积很小）
  if [[ "${NEED_OFFLINE_INSTALL}" == false ]]; then
    check_url_reachable "${K8S_PACKAGE_URL}/v${K8S_VERSION}/bin/linux/${PKG_ARCH}/kubeadm.sha256" "Kubernetes 安装包" 10
    check_url_reachable "${CONTAINERD_PACKAGE_URL}/v${CONTAINERD_VERSION}/containerd-${CONTAINERD_VERSION}-linux-${PKG_ARCH}.tar.gz.sha256sum" "containerd 安装包" 10
  fi
}

## 检查目录是否安全（避免 -i / -d 指向系统目录导致卸载时误删）
check_dir_safe () {
  local dir="$1"
  local label="$2"

  if [[ "${dir}" != /* ]]; then
    log_error "${label}必须为绝对路径： ${dir}"
  fi
  case "${dir}" in
    /|/bin|/boot|/dev|/etc|/home|/lib|/lib64|/media|/mnt|/opt|/proc|/root|/run|/sbin|/srv|/sys|/tmp|/usr|/usr/*bin|/usr/lib|/usr/local|/var|/var/lib)
      log_error "${label}不能为系统目录： ${dir}"
      ;;
  esac
}

## 检查节点状态（是否已安装、端口占用、资源、主机名、运行时冲突）
check_node () {
  local hostname_lower port
  local ports=(10250)

  # 已初始化 / 已加入集群
  if [[ -f /etc/kubernetes/kubelet.conf || -f "${KUBE_ADMIN_CONF}" ]]; then
    log_error "当前节点已初始化或已加入集群，如需重新安装请先执行【 kubernetes-tools reset 】或【 kubernetes-tools uninstall 】！"
  fi

  # 与其他方式安装的 containerd 冲突（如 containerd.io、docker-ce 软件包）
  if systemctl cat containerd.service >/dev/null 2>&1 && ! systemctl cat containerd.service 2>/dev/null | grep -q "Managed by ${TOOL_MARK}"; then
    log_error "检测到系统中已存在其他方式安装的 containerd.service，请先卸载（如 containerd.io / docker-ce 软件包）后再安装！"
  fi

  # 主机名需符合 RFC 1123（Kubernetes 节点名要求）
  hostname_lower="$(hostname | tr '[:upper:]' '[:lower:]')"
  if [[ ! "${hostname_lower}" =~ ^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$ ]]; then
    log_error "主机名【 $(hostname) 】不符合 Kubernetes 节点名规范（小写字母、数字、- 和 .），请先执行【 hostnamectl set-hostname 新主机名 】修改！"
  fi

  # 控制平面资源要求（kubeadm 预检要求至少 2 CPU、1700MB 内存）
  if [[ "${NEED_SETUP_CLUSTER}" == true && "${NODE_ROLE}" != worker ]]; then
    ports+=(6443 2379 2380 10257 10259)
    if [[ "$(nproc)" -lt 2 ]]; then
      log_warning "控制平面节点建议至少 2 个 CPU（当前 $(nproc) 个），kubeadm 预检可能失败（可设置 KUBEADM_IGNORE_PREFLIGHT_ERRORS=NumCPU 忽略）"
    fi
    if [[ "$(awk '/MemTotal/ {print int($2 / 1024)}' /proc/meminfo)" -lt 1700 ]]; then
      log_warning "控制平面节点建议至少 2GB 内存，kubeadm 预检可能失败（可设置 KUBEADM_IGNORE_PREFLIGHT_ERRORS=Mem 忽略）"
    fi
  fi

  # 端口占用
  if command -v ss >/dev/null 2>&1; then
    for port in "${ports[@]}"; do
      if ss -Hltn "sport = :${port}" 2>/dev/null | grep -q .; then
        log_warning "端口 ${port} 已被占用，kubeadm 预检可能失败"
      fi
    done
  fi

  # 防火墙提示
  if systemctl is-active --quiet firewalld 2>/dev/null || { command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q 'Status: active'; }; then
    log_warning "检测到防火墙已启用，请放行端口：控制平面 6443、2379-2380、10250、10257、10259；工作节点 10250、30000-32767；Flannel 8472/udp；Calico 179/tcp、4789/udp"
  fi
}

## 检查加入集群所需参数
check_join_params () {
  if [[ "${NODE_ROLE}" == master ]]; then
    return 0
  fi

  if [[ -z "${API_SERVER_ADDRESS}" ]]; then
    log_error "${NODE_ROLE} 角色必须通过 -m 指定集群 API Server 地址（如 192.168.1.10:6443）！"
  fi
  if [[ -z "${JOIN_TOKEN}" ]]; then
    log_error "${NODE_ROLE} 角色必须通过 -t 指定 Token（在控制平面节点执行【 kubernetes-tools token 】获取）！"
  fi
  if [[ ! "${JOIN_TOKEN}" =~ ^[a-z0-9]{6}\.[a-z0-9]{16}$ ]]; then
    log_error "Token 格式错误（应为 abcdef.0123456789abcdef 格式）！"
  fi
  if [[ -z "${JOIN_CA_CERT_HASH}" ]]; then
    log_error "${NODE_ROLE} 角色必须通过 -s 指定 CA 证书哈希（在控制平面节点执行【 kubernetes-tools token 】获取）！"
  fi
  if [[ ! "${JOIN_CA_CERT_HASH}" =~ ^sha256:[0-9a-f]{64}$ ]]; then
    log_error "CA 证书哈希格式错误（应为 sha256: 加 64 位十六进制字符）！"
  fi
  if [[ "${NODE_ROLE}" == control-plane && -z "${JOIN_CERTIFICATE_KEY}" ]]; then
    log_error "control-plane 角色必须通过 -c 指定证书密钥（在控制平面节点执行【 kubernetes-tools token 】获取）！"
  fi
}

## 检查组件是否已安装
check_installed () {
  if [[ ! -x "${K8S_INSTALL_DIR}/bin/kubeadm" ]]; then
    log_error "未在【 ${K8S_INSTALL_DIR}/bin 】找到 kubeadm，请先执行【 kubernetes-tools -a install 】安装组件（自定义安装目录时请同时指定 -i）！"
  fi
}

## 检查是否为控制平面节点
check_control_plane () {
  if [[ ! -f "${KUBE_ADMIN_CONF}" ]]; then
    log_error "未找到【 ${KUBE_ADMIN_CONF} 】，请在控制平面节点执行该命令！"
  fi
}

## 安装检查
install_check () {
  log_info '------------------------------ 开始校验安装环境... ------------------------------'

  check_systemd
  check_cpu_arch
  check_os_release

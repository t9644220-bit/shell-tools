## 配置系统参数（swap、内核模块、内核参数、SELinux）
config_system () {
  log_info '------------------------------ 开始配置系统参数... ------------------------------'

  local module
  local modules=(overlay br_netfilter)

  # 关闭 swap（kubelet 默认要求关闭 swap），并注释 /etc/fstab 中的 swap 挂载（卸载时恢复）
  if [[ "${NEED_DISABLE_SWAP}" == true ]]; then
    swapoff -a || log_warning "关闭 swap 失败"
    if grep -qE '^[^#].*[[:space:]]swap[[:space:]]' /etc/fstab; then
      backup_file /etc/fstab
      sed -i -E "/^[^#].*[[:space:]]swap[[:space:]]/ s/^/#[${TOOL_MARK}] /" /etc/fstab
      log_info "已注释 /etc/fstab 中的 swap 挂载"
    fi
    if [[ -n "$(swapon --show --noheadings 2>/dev/null || true)" ]]; then
      log_warning "swap 仍处于启用状态（可能由 zram 等机制创建），请手动关闭，否则 kubelet 将无法启动！"
    fi
  fi

  # 加载内核模块
  if [[ "${KUBE_PROXY_MODE}" == ipvs ]]; then
    modules+=(ip_vs ip_vs_rr ip_vs_wrr ip_vs_sh nf_conntrack)
  fi
  [[ -f /etc/modules-load.d/kubernetes.conf ]] && backup_file /etc/modules-load.d/kubernetes.conf
  printf '%s\n' "${modules[@]}" > /etc/modules-load.d/kubernetes.conf
  for module in "${modules[@]}"; do
    modprobe "${module}" || log_error "加载 ${module} 模块失败"
  done

  # 内核参数
  [[ -f /etc/sysctl.d/kubernetes.conf ]] && backup_file /etc/sysctl.d/kubernetes.conf
  cat > /etc/sysctl.d/kubernetes.conf <<EOF
net.bridge.bridge-nf-call-ip6tables = 1
net.bridge.bridge-nf-call-iptables = 1
net.ipv4.ip_forward = 1
EOF
  sysctl -p /etc/sysctl.d/kubernetes.conf || log_error "应用系统参数失败"

  # SELinux 设置为 permissive（kubeadm 官方建议）
  if command -v getenforce >/dev/null 2>&1 && [[ "$(getenforce)" == Enforcing ]]; then
    setenforce 0 || log_warning "设置 SELinux 为 permissive 失败"
    if [[ -f /etc/selinux/config ]]; then
      backup_file /etc/selinux/config
      sed -i 's/^SELINUX=enforcing$/SELINUX=permissive/' /etc/selinux/config
    fi
    log_info "已将 SELinux 设置为 permissive"
  fi

  log_info '------------------------------ 系统参数配置完成! ------------------------------'
}

## 移除系统参数
remove_system_config () {
  log_info '------------------------------ 开始删除系统参数... ------------------------------'

  rm -f /etc/sysctl.d/kubernetes.conf /etc/modules-load.d/kubernetes.conf
  sysctl --system >/dev/null || log_warning "重新加载系统参数失败"

  # 恢复安装时注释的 swap 挂载
  if grep -q "^#\[${TOOL_MARK}\] " /etc/fstab; then
    backup_file /etc/fstab
    sed -i "s/^#\[${TOOL_MARK}\] //" /etc/fstab
    log_info '已恢复 /etc/fstab 中的 swap 挂载，如需立即启用请执行【 swapon -a 】'
  fi

  log_info '------------------------------ 系统参数删除完成! ------------------------------'
}


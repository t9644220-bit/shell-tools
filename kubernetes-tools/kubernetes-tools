## 写入环境变量段（幂等：若已存在则先删旧块再写新块）
_write_env_block () {
  local target="$1"
  [[ -f "$target" ]] || touch "$target"

  backup_file "$target"

  # 幂等：若已有旧块先删除
  if grep -q '# Kubernetes Env Begin' "$target"; then
    sed -i '/# Kubernetes Env Begin/,/# Kubernetes Env End/d' "$target"
  fi

  cat >> "$target" <<EOF
# Kubernetes Env Begin
export KUBERNETES_HOME=${K8S_INSTALL_DIR}/bin
export PATH=\$PATH:\$KUBERNETES_HOME
# Kubernetes Env End
EOF
}

## 配置环境变量
config_env () {
  log_info '------------------------------ 开始配置环境变量... ------------------------------'

  _write_env_block ~/.bashrc
  _write_env_block /etc/profile

  # 不在脚本中 source：set -u 下其它脚本的未定义变量会导致本脚本中止
  log_info '请手动执行【 source ~/.bashrc 】和【 source /etc/profile 】更新环境变量！'

  log_info '------------------------------ 环境变量配置完成! ------------------------------'
}


## 配置镜像加速（写入 /etc/containerd/certs.d/<仓库>/hosts.toml）
config_registry_mirrors () {
  local item registry mirror server dir
  local items=()
  local -A seen=()

  [[ -n "${REGISTRY_MIRRORS}" ]] || return 0

  IFS=',' read -ra items <<<"${REGISTRY_MIRRORS}"
  for item in "${items[@]}"; do
    registry="${item%%=*}"
    mirror="${item#*=}"
    if [[ "${item}" != *=* || -z "${registry}" || -z "${mirror}" ]]; then
      log_error "镜像加速格式错误： ${item}（应为 仓库=加速地址，如 docker.io=https://docker.1ms.run）"
    fi

    dir="/etc/containerd/certs.d/${registry}"
    if [[ -z "${seen[${registry}]:-}" ]]; then
      seen[${registry}]=1
      mkdir -p "${dir}"
      [[ -f "${dir}/hosts.toml" ]] && backup_file "${dir}/hosts.toml"
      if [[ "${registry}" == docker.io ]]; then
        server=https://registry-1.docker.io
      else
        server="https://${registry}"
      fi
      printf 'server = "%s"\n' "${server}" > "${dir}/hosts.toml"
    fi
    printf '\n[host."%s"]\n  capabilities = ["pull", "resolve"]\n' "${mirror}" >> "${dir}/hosts.toml"
    log_info "已配置镜像加速： ${registry} -> ${mirror}"
  done
}

## 配置 containerd
config_containerd () {
  log_info '------------------------------ 开始配置 containerd... ------------------------------'

  local config=/etc/containerd/config.toml
  local pause_image

  [[ -f "${config}" ]] && backup_file "${config}"

  # 基于当前版本的默认配置生成，兼容 containerd 1.x / 2.x 不同的配置格式
  "${K8S_INSTALL_DIR}/bin/containerd" config default > "${config}"
  # 数据目录
  sed -i "s#^root = .*#root = '${K8S_DATA_DIR}/containerd'#" "${config}"
  # 使用 systemd cgroup 驱动（与 kubelet 保持一致）
  sed -i 's#SystemdCgroup = false#SystemdCgroup = true#' "${config}"
  # 镜像仓库配置目录（镜像加速）
  sed -i "/\.registry\]/,/config_path/ s#config_path = .*#config_path = '/etc/containerd/certs.d'#" "${config}"
  # pause 镜像（containerd 2.x 为 sandbox，1.x 为 sandbox_image）
  pause_image="$(get_pause_image)"
  if [[ -n "${pause_image}" ]]; then
    sed -i -E "s#^([[:space:]]*sandbox(_image)?[[:space:]]*=[[:space:]]*).*#\1'${pause_image}'#" "${config}"
  fi

  # 校验关键配置是否生效
  if ! grep -q 'SystemdCgroup = true' "${config}"; then
    log_error "${config} 中未能启用 SystemdCgroup，请检查 containerd 版本！"
  fi

  config_registry_mirrors

  log_info '------------------------------ containerd 配置完成! ------------------------------'
}

## 配置 crictl
config_crictl () {
  cat > /etc/crictl.yaml <<EOF
runtime-endpoint: ${CRI_SOCKET}
image-endpoint: ${CRI_SOCKET}
timeout: 10
EOF
}

## 启动 containerd 并等待就绪
start_containerd () {
  log_info '------------------------------ 开始启动 containerd... ------------------------------'

  local i

  systemctl enable containerd
  systemctl restart containerd
  for i in $(seq 1 30); do
    if [[ -S "${CRI_SOCKET#unix://}" ]] && crictl info >/dev/null 2>&1; then
      log_info '------------------------------ containerd 启动完成! ------------------------------'
      return 0
    fi
    sleep 1
  done
  log_error "containerd 启动超时，请执行【 journalctl -u containerd -n 50 】查看日志！"
}

## 获取当前节点上需要的镜像列表（kubeadm 组件镜像 + 网络插件镜像）
list_images () {
  local kubeadm_bin="$1"
  local manifest="$2"

  {
    "${kubeadm_bin}" config images list --kubernetes-version "v${K8S_VERSION}" --image-repository "${IMAGE_REPOSITORY}"
    if [[ -n "${manifest}" ]]; then
      grep -E '^[[:space:]]*image:' "${manifest}" | awk '{print $NF}' | tr -d "\"'"
    fi
  } | sort -u
}

## 补全镜像名称（ctr 要求完整名称，如 calico/node:v1 -> docker.io/calico/node:v1）
normalize_image () {
  local image="$1"
  local first="${image%%/*}"

  if [[ "${image}" != */* ]]; then
    echo "docker.io/library/${image}"
  elif [[ "${first}" != *.* && "${first}" != *:* && "${first}" != localhost ]]; then
    echo "docker.io/${image}"
  else
    echo "${image}"
  fi
}

## 导入离线镜像包
import_images () {
  local images_package="${PACKAGE_DIR}/${IMAGES_PACKAGE_NAME}"

  if [[ "${NEED_OFFLINE_INSTALL}" == false ]]; then
    return 0
  fi

  if [[ ! -f "${images_package}" ]]; then
    log_warning "未找到离线镜像包【 ${images_package} 】，将从镜像仓库【 ${IMAGE_REPOSITORY} 】拉取镜像（可在联网节点执行 save-images 生成）"
    return 0
  fi

  log_info '------------------------------ 开始导入离线镜像... ------------------------------'

  ctr -n k8s.io images import --platform "linux/${PKG_ARCH}" "${images_package}"

  log_info '------------------------------ 离线镜像导入完成! ------------------------------'
}

## 探测本机通信地址
detect_advertise_address () {
  if [[ -z "${ADVERTISE_ADDRESS}" ]]; then
    ADVERTISE_ADDRESS="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") {print $(i + 1); exit}}' || true)"
  fi
  if [[ -z "${ADVERTISE_ADDRESS}" ]]; then
    ADVERTISE_ADDRESS="$(hostname -I 2>/dev/null | awk '{print $1}' || true)"
  fi
  if [[ -z "${ADVERTISE_ADDRESS}" ]]; then
    log_error "无法自动探测本机通信地址，请通过 -l 指定！"
  fi
  log_info "本机通信地址： ${ADVERTISE_ADDRESS}"
}

## 生成 kubeadm 配置文件
render_kubeadm_config () {
  local config="${K8S_INSTALL_DIR}/conf/kubeadm-config.yaml"

  [[ -f "${config}" ]] && backup_file "${config}"

  sed -e "s#{{ADVERTISE_ADDRESS}}#${ADVERTISE_ADDRESS}#g" \
      -e "s#{{CRI_SOCKET}}#${CRI_SOCKET}#g" \
      -e "s#{{K8S_VERSION}}#${K8S_VERSION}#g" \
      -e "s#{{IMAGE_REPOSITORY}}#${IMAGE_REPOSITORY}#g" \
      -e "s#{{CONTROL_PLANE_ENDPOINT}}#${CONTROL_PLANE_ENDPOINT}#g" \
      -e "s#{{POD_CIDR}}#${POD_CIDR}#g" \
      -e "s#{{SERVICE_CIDR}}#${SERVICE_CIDR}#g" \
      -e "s#{{ETCD_DATA_DIR}}#${K8S_DATA_DIR}/etcd#g" \
      -e "s#{{KUBE_PROXY_MODE}}#${KUBE_PROXY_MODE}#g" \
      "${SCRIPT_DIR}/kubeadm-config.yaml" > "${config}"

  # 校验模板占位符是否已全部替换
  if grep -q '{{' "${config}"; then
    log_error "${config} 存在未替换的占位符，请检查模板！"
  fi
  kubeadm config validate --config "${config}" || log_error "kubeadm 配置校验失败： ${config}"
  log_info "已生成 kubeadm 配置文件： ${config}"
}

## 配置 kubectl（当前用户）
config_kubectl () {
  mkdir -p ~/.kube
  [[ -f ~/.kube/config ]] && backup_file ~/.kube/config
  cp -f "${KUBE_ADMIN_CONF}" ~/.kube/config
  chmod 600 ~/.kube/config
  log_info "已配置 kubectl： ~/.kube/config"
}

## 安装网络插件
install_network_plugin () {
  local manifest="${PACKAGE_DIR}/${NETWORK_MANIFEST_NAME}"
  local target="${K8S_INSTALL_DIR}/conf/${NETWORK_PLUGIN}.yaml"

  if [[ "${NETWORK_PLUGIN}" == none ]]; then
    log_warning '未安装网络插件（-n none），节点将保持 NotReady，请自行安装 CNI 网络插件！'
    return 0
  fi

  log_info "------------------------------ 开始安装网络插件（${NETWORK_PLUGIN}）... ------------------------------"

  if [[ ! -s "${manifest}" ]]; then
    if [[ "${NEED_OFFLINE_INSTALL}" == true ]]; then
      log_error "未找到网络插件清单【 ${manifest} 】，请先在联网机器上执行【 kubernetes-tools -n ${NETWORK_PLUGIN} download 】！"
    fi
    mkdir -p "${PACKAGE_DIR}"
    download_file "${NETWORK_MANIFEST_URL}" "${manifest}"
  fi

  cp -f "${manifest}" "${target}"
  if [[ "${NETWORK_PLUGIN}" == flannel ]]; then
    # Flannel 默认网段为 10.244.0.0/16，需与 Pod 网段一致
    sed -i "s#\"Network\": \"10.244.0.0/16\"#\"Network\": \"${POD_CIDR}\"#" "${target}"
    if [[ "${KUBE_PROXY_MODE}" == nftables ]]; then
      sed -i 's#"EnableNFTables": false#"EnableNFTables": true#' "${target}"
    fi
  fi
  # Calico 清单方式部署时会自动识别 kubeadm 配置的 Pod 网段，无需修改

  kubectl --kubeconfig "${KUBE_ADMIN_CONF}" apply -f "${target}"

  log_info "------------------------------ 网络插件（${NETWORK_PLUGIN}）安装完成! ------------------------------"
}

## 获取节点名称（与 kubeadm 一致：小写主机名）
get_node_name () {
  hostname | tr '[:upper:]' '[:lower:]'
}

## 允许在控制平面节点调度 Pod
untaint_master () {
  if [[ "${NEED_UNTAINT_MASTER}" == true ]]; then
    kubectl --kubeconfig "${KUBE_ADMIN_CONF}" taint nodes "$(get_node_name)" node-role.kubernetes.io/control-plane:NoSchedule- \
      || log_warning '移除控制平面污点失败（可能已移除）'
  fi
}

## 等待节点就绪
wait_node_ready () {
  if [[ "${NETWORK_PLUGIN}" == none ]]; then
    return 0
  fi
  log_info '等待节点就绪（最长 5 分钟）...'
  kubectl --kubeconfig "${KUBE_ADMIN_CONF}" wait --for=condition=Ready "node/$(get_node_name)" --timeout=300s \
    || log_warning '节点在 5 分钟内未就绪，请执行【 kubectl get pods -A 】检查网络插件状态！'
}

## 获取 kubeadm 预检忽略参数
preflight_args () {
  if [[ -n "${KUBEADM_IGNORE_PREFLIGHT_ERRORS}" ]]; then
    echo "--ignore-preflight-errors=${KUBEADM_IGNORE_PREFLIGHT_ERRORS}"
  fi
}

## 初始化集群（第一个控制平面节点）
init_cluster () {
  log_info '------------------------------ 开始初始化集群... ------------------------------'

  local config="${K8S_INSTALL_DIR}/conf/kubeadm-config.yaml"
  local log_file="${K8S_INSTALL_DIR}/conf/kubeadm-init.log"
  local args=(init --config "${config}")

  detect_advertise_address
  render_kubeadm_config

  # 在线时预先拉取镜像（离线时使用已导入的镜像，kubeadm 按 IfNotPresent 策略不再拉取）
  if [[ "${NEED_OFFLINE_INSTALL}" == false ]]; then
    log_info '开始拉取 Kubernetes 组件镜像...'
    kubeadm config images pull --config "${config}" || log_error "拉取镜像失败，请检查网络或通过 -g 指定可访问的镜像仓库！"
  fi

  # 高可用时上传证书，供其他控制平面节点加入
  if [[ -n "${CONTROL_PLANE_ENDPOINT}" ]]; then
    args+=(--upload-certs)
  fi
  if [[ -n "${KUBEADM_IGNORE_PREFLIGHT_ERRORS}" ]]; then
    args+=("$(preflight_args)")
  fi

  # 日志中包含 Token、证书密钥等敏感信息，仅 root 可读
  (umask 077 && kubeadm "${args[@]}" 2>&1 | tee "${log_file}") \
    || log_error "集群初始化失败，日志见【 ${log_file} 】，修复问题后请执行【 kubernetes-tools reset 】再重试！"

  config_kubectl
  install_network_plugin
  untaint_master
  wait_node_ready

  log_info '------------------------------ 集群初始化完成! ------------------------------'

  print_join_command
}

## 加入集群（worker / control-plane）
join_cluster () {
  log_info "------------------------------ 开始加入集群（${NODE_ROLE}）... ------------------------------"

  local args=(join "${API_SERVER_ADDRESS}" --token "${JOIN_TOKEN}" --discovery-token-ca-cert-hash "${JOIN_CA_CERT_HASH}" --cri-socket "${CRI_SOCKET}")

  if [[ "${NODE_ROLE}" == control-plane ]]; then
    detect_advertise_address
    args+=(--control-plane --certificate-key "${JOIN_CERTIFICATE_KEY}" --apiserver-advertise-address "${ADVERTISE_ADDRESS}")
  fi
  if [[ -n "${KUBEADM_IGNORE_PREFLIGHT_ERRORS}" ]]; then
    args+=("$(preflight_args)")
  fi

  kubeadm "${args[@]}" || log_error "加入集群失败，修复问题后请执行【 kubernetes-tools reset 】再重试！"

  if [[ "${NODE_ROLE}" == control-plane ]]; then
    config_kubectl
    untaint_master
  fi

  log_info "------------------------------ 加入集群（${NODE_ROLE}）完成! ------------------------------"
  if [[ "${NODE_ROLE}" == worker ]]; then
    log_info '请在控制平面节点执行【 kubectl get nodes 】查看节点状态'
  fi
}

## 设置集群（按角色初始化或加入）
setup_cluster () {
  if [[ "${NODE_ROLE}" == master ]]; then
    init_cluster
  else
    join_cluster
  fi
}

## 生成节点加入命令（控制平面节点）
print_join_command () {
  local join_cmd address token hash endpoint certificate_key

  check_control_plane

  join_cmd="$(kubeadm token create --print-join-command)" || log_error "生成 Token 失败！"
  address="$(awk '{print $3}' <<<"${join_cmd}")"
  token="$(awk '{for (i = 1; i < NF; i++) if ($i == "--token") print $(i + 1)}' <<<"${join_cmd}")"
  hash="$(awk '{for (i = 1; i < NF; i++) if ($i == "--discovery-token-ca-cert-hash") print $(i + 1)}' <<<"${join_cmd}")"

  log_success '======================================== 节点加入命令 ========================================'
  log_success 'Worker 节点（Token 有效期 24 小时）：'
  log_success "  kubernetes-tools -r worker -m ${address} -t ${token} -s ${hash} install"
  log_success "  （或使用原生命令： ${join_cmd}）"

  endpoint="$(kubectl --kubeconfig "${KUBE_ADMIN_CONF}" -n kube-system get configmap kubeadm-config -o jsonpath='{.data.ClusterConfiguration}' 2>/dev/null \
    | awk '/^controlPlaneEndpoint:/ {print $2}' | tr -d "\"'" || true)"
  if [[ -n "${endpoint}" ]]; then
    certificate_key="$(kubeadm init phase upload-certs --upload-certs 2>/dev/null | tail -n 1 || true)"
    if [[ "${certificate_key}" =~ ^[0-9a-f]{64}$ ]]; then
      log_success '控制平面节点（证书密钥有效期 2 小时）：'
      log_success "  kubernetes-tools -r control-plane -m ${address} -t ${token} -s ${hash} -c ${certificate_key} install"
    else
      log_warning '生成证书密钥失败，请手动执行【 kubeadm init phase upload-certs --upload-certs 】'
    fi
  else
    log_info '集群未配置控制平面统一入口（-e），不支持加入其他控制平面节点'
  fi
  log_success '提示：其他节点的 -v、-g、-w 等参数请与本节点保持一致'
  log_success '=============================================================================================='
}

## 重置节点（退出集群，清理集群相关数据，保留已安装组件）
reset_node () {
  log_info '------------------------------ 开始重置节点... ------------------------------'

  local link

  if [[ -x "${K8S_INSTALL_DIR}/bin/kubeadm" ]]; then
    # kubeadm reset 需要通过 containerd 清理容器
    if systemctl cat containerd.service >/dev/null 2>&1; then
      systemctl start containerd || log_warning "启动 containerd 失败"
    fi
    kubeadm reset -f --cri-socket "${CRI_SOCKET}" || log_warning "kubeadm reset 执行失败"
  fi

  # 清理网络插件残留
  rm -rf /etc/cni/net.d/* /var/lib/cni /run/flannel
  for link in cni0 flannel.1 flannel-v6.1 vxlan.calico vxlan-v6.calico kube-ipvs0; do
    if ip link show "${link}" >/dev/null 2>&1; then
      ip link delete "${link}" || log_warning "删除网卡 ${link} 失败"
    fi
  done
  if command -v ipvsadm >/dev/null 2>&1; then
    ipvsadm --clear || true
  fi

  if [[ -f ~/.kube/config ]]; then
    backup_file ~/.kube/config
    rm -f ~/.kube/config
  fi

  log_warning 'kubeadm reset 不会清理 iptables / nftables 规则，如需清理请手动执行【 iptables -F && iptables -t nat -F && iptables -t mangle -F && iptables -X 】（会清除本机全部规则，请谨慎执行）'

  log_info '------------------------------ 节点重置完成! ------------------------------'
}


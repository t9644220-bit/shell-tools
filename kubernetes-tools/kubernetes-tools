join () {
  check_systemd
  check_installed
  if [[ "${NODE_ROLE}" == master ]]; then
    log_error 'join 需要通过 -r 指定角色为 worker 或 control-plane！'
  fi
  check_node
  check_join_params

  log_info '加入参数如下 ：'
  print_params
  if confirm_action '请确认加入参数是否正确（y：加入，n：不加入）'; then
    join_cluster
  else
    log_warning '用户取消加入。'
    exit 1
  fi
}

## 重置节点
reset () {
  if confirm_action '此操作将使本节点退出集群，并删除集群相关数据（若为最后一个控制平面节点，集群数据将全部丢失），请确认是否重置（y：重置，n：不重置）'; then
    reset_node
  else
    log_warning '用户取消重置。'
    exit 1
  fi
}

## 卸载 Kubernetes
uninstall () {
  log_info '===================================================================================================='
  log_info "$(date '+%Y-%m-%d %H:%M:%S')"
  log_info '============================== 开始卸载 Kubernetes ...... =============================='

  log_info '删除目录如下 ：'
  log_info '安装目录 ： '"${K8S_INSTALL_DIR}"
  log_info '数据目录 ： '"${K8S_DATA_DIR}"
  log_info '集群配置 ： /etc/kubernetes、/var/lib/kubelet、/etc/containerd、/etc/cni、'"${CNI_BIN_DIR}"
  log_warning '工作节点卸载前，建议先在控制平面节点执行【 kubectl drain 节点名 --ignore-daemonsets --delete-emptydir-data 】和【 kubectl delete node 节点名 】'
  if confirm_action '此操作将会使本节点退出集群，并删除所有文件（包含程序文件、镜像、容器、etcd 数据等），请确认是否卸载（y：卸载，n：不卸载）'; then
    reset_node
    # 服务不存在时（未安装或安装中途失败）systemctl 会报错，在 set -e 下会中止后续清理
    if systemctl cat kubelet.service >/dev/null 2>&1; then
      systemctl disable --now kubelet || log_warning "停止 kubelet 失败"
    fi
    if systemctl cat containerd.service >/dev/null 2>&1; then
      systemctl disable --now containerd || log_warning "停止 containerd 失败"
    fi
    remove_service
    remove_env
    remove_system_config
    delete_dir
  else
    log_warning '用户取消卸载。'
    exit 1
  fi

  log_info '============================== Kubernetes 卸载完成！！！ =============================='
  log_info "$(date '+%Y-%m-%d %H:%M:%S')"
  log_info '===================================================================================================='
}

## 更新 Kubernetes
update () {
  log_info '===================================================================================================='
  log_info "$(date '+%Y-%m-%d %H:%M:%S')"
  log_info '============================== 开始更新 Kubernetes ...... =============================='

  local current_version cluster_version current_minor target_minor
  local upgrade_type=node

  check_systemd
  check_installed
  check_cpu_arch
  init_package_names
  check_command
  if [[ "${NEED_OFFLINE_INSTALL}" == true ]]; then
    check_package "kubeadm-${KUBE_PACKAGE_SUFFIX}"
    check_package "kubelet-${KUBE_PACKAGE_SUFFIX}"
    check_package "kubectl-${KUBE_PACKAGE_SUFFIX}"
  else
    check_net
  fi

  # 版本校验：不允许降级，不允许跨次版本升级
  current_version="$(kubeadm version -o short)"
  current_version="${current_version#v}"
  current_minor="$(cut -d. -f2 <<<"${current_version}")"
  target_minor="$(cut -d. -f2 <<<"${K8S_VERSION}")"
  if version_lt "${K8S_VERSION}" "${current_version}"; then
    log_error "不支持降级（当前 ${current_version}，目标 ${K8S_VERSION}）！"
  fi
  if [[ "$(cut -d. -f1 <<<"${current_version}")" != "$(cut -d. -f1 <<<"${K8S_VERSION}")" || $((target_minor - current_minor)) -gt 1 ]]; then
    log_error "kubeadm 仅支持逐个次版本升级（当前 ${current_version}，目标 ${K8S_VERSION}），请先升级到 1.$((current_minor + 1)).x！"
  fi
  if [[ "${current_version}" == "${K8S_VERSION}" ]]; then
    log_warning "当前 kubeadm 已是 ${K8S_VERSION}，将继续执行升级流程（用于完成上次未完成的升级）"
  fi

  # 升级方式：第一个控制平面节点执行 upgrade apply，其他节点执行 upgrade node
  if [[ -f /etc/kubernetes/manifests/kube-apiserver.yaml && -f "${KUBE_ADMIN_CONF}" ]]; then
    cluster_version="$(kubectl --kubeconfig "${KUBE_ADMIN_CONF}" -n kube-system get configmap kubeadm-config -o jsonpath='{.data.ClusterConfiguration}' \
      | awk '/^kubernetesVersion:/ {print $2}' | tr -d "\"'")" || log_error "获取集群版本失败，请检查 API Server 状态！"
    if [[ "${cluster_version#v}" != "${K8S_VERSION}" ]]; then
      upgrade_type=apply
    fi
  fi

  log_info '更新参数如下 ：'
  log_info 'CPU 架构 ： '"${CPU_ARCH}"
  log_info '安装目录 ： '"${K8S_INSTALL_DIR}"
  log_info '是否离线安装 ： '"${NEED_OFFLINE_INSTALL}"
  log_info '当前版本 ： '"${current_version}"
  log_info '目标版本 ： '"${K8S_VERSION}"
  log_info '升级方式 ： kubeadm upgrade '"${upgrade_type}"
  log_warning '升级前建议先执行【 kubectl drain 节点名 --ignore-daemonsets 】驱逐本节点 Pod，升级完成后执行【 kubectl uncordon 节点名 】恢复调度'
  if confirm_action '此操作将会更新当前 Kubernetes 版本，存在一定风险，请确认是否更新（y：更新，n：不更新）'; then
    log_info '------------------------------ 开始更新 Kubernetes 组件... ------------------------------'

    if [[ "${NEED_OFFLINE_INSTALL}" == false ]]; then
      download_kube_packages
    fi
    import_images
    backup_kube_binaries

    # 先升级 kubeadm，再由 kubeadm 升级控制平面 / 节点配置
    command install -m 755 "${PACKAGE_DIR}/kubeadm-${KUBE_PACKAGE_SUFFIX}" "${K8S_INSTALL_DIR}/bin/kubeadm"
    if [[ "${upgrade_type}" == apply ]]; then
      kubeadm upgrade plan "v${K8S_VERSION}" || log_error "升级预检失败，可从【 ${K8S_INSTALL_DIR}/backup/${DATETIME} 】恢复 kubeadm！"
      kubeadm upgrade apply "v${K8S_VERSION}" --yes || log_error "升级控制平面失败，可从【 ${K8S_INSTALL_DIR}/backup/${DATETIME} 】恢复 kubeadm！"
    else
      kubeadm upgrade node || log_error "升级节点失败，可从【 ${K8S_INSTALL_DIR}/backup/${DATETIME} 】恢复 kubeadm！"
    fi

    # 再升级 kubelet、kubectl 并重启 kubelet
    command install -m 755 "${PACKAGE_DIR}/kubelet-${KUBE_PACKAGE_SUFFIX}" "${K8S_INSTALL_DIR}/bin/kubelet"
    command install -m 755 "${PACKAGE_DIR}/kubectl-${KUBE_PACKAGE_SUFFIX}" "${K8S_INSTALL_DIR}/bin/kubectl"
    systemctl daemon-reload
    systemctl restart kubelet

    log_info '------------------------------ Kubernetes 组件更新完成! ------------------------------'
  else
    log_warning '用户取消更新。'
    exit 1
  fi

  log_info '============================== Kubernetes 更新完成！！！ =============================='
  log_info "$(date '+%Y-%m-%d %H:%M:%S')"
  log_info '===================================================================================================='
}

## 下载离线安装包
download () {
  log_info '============================== 开始下载离线安装包 ...... =============================='

  if ! command -v curl >/dev/null 2>&1; then
    log_error "请先安装 curl!"
  fi
  if ! command -v sha256sum >/dev/null 2>&1; then
    log_error "请先安装 sha256sum（coreutils）!"
  fi
  resolve_package_arch
  init_package_names

  log_info '下载参数如下 ：'
  log_info '安装包目录 ： '"${PACKAGE_DIR}"
  log_info 'Kubernetes 版本 ： '"${K8S_VERSION}"
  log_info 'containerd / runc / CNI / crictl 版本 ： '"${CONTAINERD_VERSION} / ${RUNC_VERSION} / ${CNI_PLUGINS_VERSION} / ${CRICTL_VERSION}"
  log_info '网络插件 ： '"${NETWORK_PLUGIN}"

  download_packages

  ls -lh "${PACKAGE_DIR}"
  log_info '============================== 离线安装包下载完成！！！ =============================='
  log_info "离线镜像需在已安装组件的联网节点上执行【 kubernetes-tools save-images 】导出"
  log_info "请将本工具目录（含 packages）完整拷贝至目标服务器，并执行【 kubernetes-tools -o install 】离线安装"
}

## 导出离线镜像包
save_images () {
  log_info '============================== 开始导出离线镜像包 ...... =============================='

  local kubeadm_bin manifest images_package i
  local images=()

  check_installed
  resolve_package_arch
  init_package_names
  if ! systemctl is-active --quiet containerd; then
    log_error "containerd 未运行，请先执行【 kubernetes-tools start 】！"
  fi

  # 获取镜像列表需执行与目标版本一致的 kubeadm（本机架构）
  kubeadm_bin="${PACKAGE_DIR}/kubeadm-v${K8S_VERSION}-linux-${HOST_ARCH}"
  if [[ "$(kubeadm version -o short)" == "v${K8S_VERSION}" ]]; then
    kubeadm_bin="${K8S_INSTALL_DIR}/bin/kubeadm"
  elif [[ -s "${kubeadm_bin}" || "${NEED_OFFLINE_INSTALL}" == false ]]; then
    mkdir -p "${PACKAGE_DIR}"
    download_file "${K8S_PACKAGE_URL}/v${K8S_VERSION}/bin/linux/${HOST_ARCH}/kubeadm" "${kubeadm_bin}" \
      "${K8S_PACKAGE_URL}/v${K8S_VERSION}/bin/linux/${HOST_ARCH}/kubeadm.sha256"
    chmod +x "${kubeadm_bin}"
  else
    log_error "未找到 ${K8S_VERSION} 版本的 kubeadm，请先执行【 kubernetes-tools -v ${K8S_VERSION} download 】！"
  fi

  manifest=""
  if [[ -n "${NETWORK_MANIFEST_NAME}" ]]; then
    manifest="${PACKAGE_DIR}/${NETWORK_MANIFEST_NAME}"
    if [[ ! -s "${manifest}" ]]; then
      mkdir -p "${PACKAGE_DIR}"
      download_file "${NETWORK_MANIFEST_URL}" "${manifest}"
    fi
  fi

  mapfile -t images < <(list_images "${kubeadm_bin}" "${manifest}")
  if [[ ${#images[@]} -eq 0 ]]; then
    log_error "获取镜像列表失败！"
  fi

  for i in "${!images[@]}"; do
    images[i]="$(normalize_image "${images[i]}")"
    log_info "开始拉取镜像： ${images[i]}（linux/${PKG_ARCH}）"
    ctr -n k8s.io images pull --hosts-dir /etc/containerd/certs.d --platform "linux/${PKG_ARCH}" "${images[i]}" >/dev/null \
      || log_error "拉取镜像失败： ${images[i]}，请检查网络或通过 -g / -w 指定可访问的镜像仓库！"
  done

  images_package="${PACKAGE_DIR}/${IMAGES_PACKAGE_NAME}"
  # 先导出到临时文件，避免导出失败时留下不完整的镜像包
  ctr -n k8s.io images export --platform "linux/${PKG_ARCH}" "${images_package}.part" "${images[@]}" \
    || { rm -f "${images_package}.part"; log_error "导出镜像失败！"; }
  mv -f "${images_package}.part" "${images_package}"
  (cd "${PACKAGE_DIR}" && sha256sum "${IMAGES_PACKAGE_NAME}" > "${IMAGES_PACKAGE_NAME}.sha256")

  ls -lh "${images_package}"
  log_info '============================== 离线镜像包导出完成！！！ =============================='
  log_info "离线安装时请使用相同的 -v、-n、-g 参数，镜像包将被自动导入"
}

# 初始化选项
while getopts ":v:i:d:k:b:r:l:e:m:t:s:c:n:p:x:g:w:aouy" opt; do
  case $opt in
    v)
      ## 设置 Kubernetes 版本（兼容 v 前缀）
      K8S_VERSION="${OPTARG#v}"
      if [[ ! "${K8S_VERSION}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        log_error "Kubernetes 版本号格式错误： ${OPTARG}（如 1.37.1）"
      fi
      log_info '用户自定义 Kubernetes 版本： '"${K8S_VERSION}"
      ;;
    i)
      ## 设置安装目录
      K8S_INSTALL_DIR="$(strip_slash "${OPTARG}")"
      log_info '用户自定义安装目录： '"${K8S_INSTALL_DIR}"
      ;;
    d)
      ## 设置数据目录
      K8S_DATA_DIR="$(strip_slash "${OPTARG}")"
      log_info '用户自定义数据目录： '"${K8S_DATA_DIR}"
      ;;
    k)
      ## 设置安装包目录
      PACKAGE_DIR="$(strip_slash "${OPTARG}")"
      log_info '用户自定义安装包目录： '"${PACKAGE_DIR}"
      ;;
    b)
      ## 设置安装包架构（仅 download / save-images 使用）
      TARGET_ARCH="${OPTARG}"
      log_info '用户自定义安装包架构： '"${OPTARG}"
      ;;
    o)
      ## 设置离线安装
      NEED_OFFLINE_INSTALL=true
      log_info '用户自定义： 离线安装'
      ;;
    r)
      ## 设置节点角色
      if [[ "${OPTARG}" != master && "${OPTARG}" != worker && "${OPTARG}" != control-plane ]]; then
        log_error '角色错误，可选择：master、worker、control-plane'
      fi
      NODE_ROLE="${OPTARG}"
      log_info "用户自定义： 节点角色（${OPTARG}）"
      ;;
    a)
      ## 设置仅安装组件
      NEED_SETUP_CLUSTER=false
      log_info '用户自定义： 仅安装组件，不初始化 / 加入集群'
      ;;
    l)
      ## 设置本机通信地址
      ADVERTISE_ADDRESS="${OPTARG}"
      log_info "用户自定义： 本机通信地址（${OPTARG}）"
      ;;
    e)
      ## 设置控制平面统一入口
      CONTROL_PLANE_ENDPOINT="${OPTARG}"
      log_info "用户自定义： 控制平面统一入口（${OPTARG}）"
      ;;
    m)
      ## 设置集群 API Server 地址（未指定端口时默认 6443）
      API_SERVER_ADDRESS="${OPTARG}"
      [[ "${API_SERVER_ADDRESS}" == *:* ]] || API_SERVER_ADDRESS="${API_SERVER_ADDRESS}:6443"
      log_info "用户自定义： 集群 API Server 地址（${API_SERVER_ADDRESS}）"
      ;;
    t)
      ## 设置 Token
      JOIN_TOKEN="${OPTARG}"
      log_info "用户自定义： Token（******）"
      ;;
    s)
      ## 设置 CA 证书哈希（兼容不带 sha256: 前缀）
      JOIN_CA_CERT_HASH="${OPTARG}"
      [[ "${JOIN_CA_CERT_HASH}" == sha256:* ]] || JOIN_CA_CERT_HASH="sha256:${JOIN_CA_CERT_HASH}"
      log_info "用户自定义： CA 证书哈希（${JOIN_CA_CERT_HASH}）"
      ;;
    c)
      ## 设置证书密钥
      JOIN_CERTIFICATE_KEY="${OPTARG}"
      log_info "用户自定义： 证书密钥（******）"
      ;;
    n)
      ## 设置网络插件
      if [[ "${OPTARG}" != flannel && "${OPTARG}" != calico && "${OPTARG}" != none ]]; then
        log_error '网络插件错误，可选择：flannel、calico、none'
      fi
      NETWORK_PLUGIN="${OPTARG}"
      log_info "用户自定义： 网络插件（${OPTARG}）"
      ;;
    p)
      ## 设置 Pod 网段
      POD_CIDR="${OPTARG}"
      log_info "用户自定义： Pod 网段（${OPTARG}）"
      ;;
    x)
      ## 设置 Service 网段
      SERVICE_CIDR="${OPTARG}"
      log_info "用户自定义： Service 网段（${OPTARG}）"
      ;;
    g)
      ## 设置镜像仓库
      IMAGE_REPOSITORY="${OPTARG%/}"
      log_info "用户自定义： 镜像仓库（${IMAGE_REPOSITORY}）"
      ;;
    w)
      ## 设置镜像加速
      REGISTRY_MIRRORS="${OPTARG}"
      log_info "用户自定义： 镜像加速（${OPTARG}）"
      ;;
    u)
      ## 设置允许控制平面调度 Pod
      NEED_UNTAINT_MASTER=true
      log_info '用户自定义： 允许在控制平面节点调度 Pod'
      ;;
    y)
      ## 设置跳过交互确认
      ASSUME_YES=true
      ;;
    \?)
      log_error "未知选项： -${OPTARG}，请执行【 kubernetes-tools help 】查看帮助！"
      ;;
    :)
      log_error "选项 -${OPTARG} 缺少参数值！"
      ;;
  esac
done


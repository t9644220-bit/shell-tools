## 安装 Docker Engine
only_install_docker_engine () {
  log_info '------------------------------ 开始安装 Docker Engine... ------------------------------'

  create_dir
  create_user
  config_system
  if [[ "${NEED_OFFLINE_INSTALL}" == false ]];then
    download_docker_engine_package 
  fi
  install_docker_engine
  config_env
  config_service
  config_docker_engine
  start_docker
  if [[ "${NEED_ENABLE_DOCKER}" == true ]];then
    enable_docker
  fi
  info_docker

  log_info '------------------------------ Docker Engine 安装完成! ------------------------------'
}

## 安装 Docker Compose
only_install_docker_compose () {
  log_info '------------------------------ 开始安装 Docker Compose... ------------------------------'

  # 仅安装 Compose（-b）时 Engine 流程未执行，需自行准备用户、目录和环境变量
  create_user
  mkdir -pv "${DOCKER_INSTALL_DIR}"/{bin,conf}
  if [[ "${NEED_INSTALL_ENGINE}" == false ]]; then
    config_env
  fi

  if [[ "${NEED_OFFLINE_INSTALL}" == false ]]; then
    download_docker_compose_package
  fi
  install_docker_compose

  # 仅当 docker 服务可用时才重启并查询 info
  if systemctl list-unit-files docker.service >/dev/null 2>&1 && systemctl is-active --quiet docker; then
    restart_docker
    info_docker
  else
    log_info 'Docker Engine 尚未安装或未运行，跳过 restart/info 步骤。'
  fi

  log_info '------------------------------ Docker Compose 安装完成! ------------------------------'
}

## 更新 Docker Engine 
only_update_docker_engine () {

## 卸载 Docker
uninstall () {
  log_info '===================================================================================================='
  log_info "$(date '+%Y-%m-%d %H:%M:%S')"
  log_info '============================== 开始卸载 Docker ...... =============================='

  log_info '删除目录如下 ：'
  log_info 'Docker 安装目录 ： '"${DOCKER_INSTALL_DIR}"
  log_info 'Docker 数据目录 ： '"${DOCKER_DATA_DIR}"
  if confirm_action '此操作将会卸载 Docker 服务，并删除所有文件（包含 Docker 程序文件、镜像、容器文件等），请确认是否卸载（y：卸载，n：不卸载）'; then
    # 服务不存在时（未安装或安装中途失败）systemctl 会报错，在 set -e 下会中止后续清理
    if systemctl cat docker.service >/dev/null 2>&1; then
      disable_docker
      stop_docker
    else
      log_warning '未找到 docker.service，跳过取消自启动和停止步骤。'
    fi
    remove_service
    remove_env
    remove_system_config
    delete_user
    delete_dir
  else
    log_warning '用户取消卸载。'
    exit 1
  fi

  log_info '============================== Docker 卸载完成！！！ =============================='
  log_info "$(date '+%Y-%m-%d %H:%M:%S')"
  log_info '===================================================================================================='
}

